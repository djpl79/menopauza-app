# Secret used to sign/verify JWT auth tokens. Generate a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# and set it here (or as a real environment variable) before deploying.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: host/port the backend listens on.
PORT=5000
HOST=0.0.0.0
