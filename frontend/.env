# Leave REACT_APP_API_URL unset to let the app auto-detect the backend URL
# (works both locally and in Replit, where the frontend/backend share a
# host but run on different ports).
#
# Only set this explicitly if auto-detection doesn't work for your setup,
# e.g. for a production deployment with a fixed API domain:
# REACT_APP_API_URL=https://api.example.com

# Ports used by the backend/frontend (used for Replit URL auto-detection).
REACT_APP_BACKEND_PORT=5000
REACT_APP_FRONTEND_PORT=3000
